# SECURITY NOTICE: Never store actual API keys in config files!
# This file shows EXAMPLE environment variable names and formats.
# Replace the placeholder values below with your actual API keys.
# Real API keys should only be set as environment variables, NEVER in config files.

# Gemini API Keys for Round-Robin Configuration
# Configure multiple Gemini API keys for round-robin usage
# WARNING: Replace these placeholder values with your actual API keys
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
GEMINI_API_KEY_4=your_fourth_gemini_api_key_here
GEMINI_API_KEY_5=your_fifth_gemini_api_key_here

# Set Gemini as the default backend
LLM_BACKEND=gemini

# Google Cloud Project ID (required for Gemini CLI Direct backend)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Client API key for accessing this proxy (used when disable_auth=false)
# WARNING: Replace with your actual proxy authentication key
LLM_INTERACTIVE_PROXY_API_KEY=choose_a_secret_key

# API brute-force protection (invalid key throttling)
BRUTE_FORCE_PROTECTION_ENABLED=true
BRUTE_FORCE_MAX_FAILED_ATTEMPTS=5
BRUTE_FORCE_TTL_SECONDS=900
BRUTE_FORCE_INITIAL_BLOCK_SECONDS=30
BRUTE_FORCE_BLOCK_MULTIPLIER=2.0
BRUTE_FORCE_MAX_BLOCK_SECONDS=3600

# Optional settings
REDACT_API_KEYS_IN_PROMPTS=true
DISABLE_INTERACTIVE_COMMANDS=false
# PROJECT_DIR_RESOLUTION_MODEL=openai:gpt-4o-mini

# Interleaved thinker routing
# INTERLEAVED_THINKING_INSTRUCTIONS_FILE=./config/prompts/interleaved_thinking/thinker_prompt.md
# INTERLEAVED_THINKING_STREAM_TO_CLIENT=false
# INTERLEAVED_THINKING_REGULAR_TURNS_REMAINING=2

# ProxyMem (Cross-Session Memory)
# MEMORY_AVAILABLE=true
# MEMORY_DEFAULT_ENABLED=false
# MEMORY_SUMMARY_MODEL=openai:gpt-4o-mini
# MEMORY_CONTEXT_MODEL=openai:gpt-4o-mini
# MEMORY_SUMMARY_PROMPT=./config/prompts/memory_summary.md
# MEMORY_CONTEXT_PROMPT=./config/prompts/memory_context.md
# MEMORY_DATABASE_PATH=./var/memory.sqlite3
# MEMORY_SESSION_TIMEOUT_MINUTES=30
# MEMORY_SUMMARIZATION_DELAY_SECONDS=120
# MEMORY_MAX_SESSIONS_TO_CONSIDER=10
# MEMORY_MAX_CONTEXT_TOKENS=2000
# MEMORY_MAX_SUMMARY_TOKENS=800
# MEMORY_MAX_TRANSCRIPT_CHARS=50000
# MEMORY_SUMMARY_COMPLETION_TOKENS=10000
# MEMORY_CONTEXT_RELEVANCE_THRESHOLD=0.5
# MEMORY_MAX_BUFFER_SIZE_BYTES=10485760
# MEMORY_ANALYSIS_QUEUE_MAXSIZE=100
# MEMORY_ANALYSIS_TIMEOUT_SECONDS=30
# MEMORY_MAX_CONCURRENT_ANALYSES=4
# MEMORY_CONTEXT_TEMPLATE="<prior_session_context>\n{context}\n</prior_session_context>"
# MEMORY_PERSIST_TRANSCRIPT=false
# MEMORY_REDACTION_PATTERNS=token=\\w+,password=\\w+
# MEMORY_DISABLED_USERS=user123,user456
# MEMORY_DISABLED_CLIENTS=Roo Cline
# MEMORY_SINGLE_USER_MODE=false
# MEMORY_FIXED_USER_ID=personal
# MEMORY_SUMMARY_PROMPT_VERSION=v1
# MEMORY_SUMMARY_SCHEMA_VERSION=v1
# MEMORY_REQUIRE_PROJECT_DISCOVERY=true
# MEMORY_PROJECT_DISCOVERY_MODE=any

# Resilience scoping overrides (comma-separated backend types)
# RESILIENCE_PERSONAL_BACKEND_TYPES=qwen-oauth,openai-codex
# RESILIENCE_SHARED_BACKEND_TYPES=openai,openrouter

# Tool Call Repair (auto-convert plain-text tool calls)
# Enabled by default; set to false to disable
TOOL_CALL_REPAIR_ENABLED=true
# Cap per-session streaming repair buffer in bytes (default 65536)
TOOL_CALL_REPAIR_BUFFER_CAP_BYTES=65536

# Quality Verifier (optional guardian model)
# QUALITY_VERIFIER_MODEL=openai:gpt-4o-mini?temperature=0.2
# Run Angel every N user turns (defaults to 1 when unset)
QUALITY_VERIFIER_FREQUENCY=1

# Loop Detection Settings
LOOP_DETECTION_ENABLED=true
LOOP_DETECTION_BUFFER_SIZE=2048
LOOP_DETECTION_MAX_PATTERN_LENGTH=500

# Tool Call Reactor Settings
# Event-driven system for reacting to tool calls from LLMs
TOOL_CALL_REACTOR_ENABLED=true
# Enable/disable steering for apply_diff -> patch_file recommendations
APPLY_DIFF_STEERING_ENABLED=true
# How often to show steering messages per session (seconds)
APPLY_DIFF_STEERING_RATE_LIMIT_SECONDS=60
# Enable steering that warns before running the entire pytest suite (opt-in)
PYTEST_FULL_SUITE_STEERING_ENABLED=false
# Steering for cat > / cat >> file create-append via shell (opt-in)
CAT_FILE_EDITS_STEERING_ENABLED=false
# Optional custom message:
# CAT_FILE_EDITS_STEERING_MESSAGE=

# Binary File Edit Steering Settings
# Detects and warns when agents attempt to edit binary files (executables, media, databases, etc.)
# Default: enabled (DISABLE_BINARY_FILE_EDIT_STEERING=false)
DISABLE_BINARY_FILE_EDIT_STEERING=false
# Optional custom message:
# BINARY_FILE_EDIT_STEERING_MESSAGE=

# Test Execution Reminder Settings
# Enable steering that reminds agents to run tests before completing tasks (opt-in)
# Expected values: true or false (default: false)
TEST_EXECUTION_REMINDER_ENABLED=false
# Optional custom message for test execution reminders
# If not set, uses default message instructing agents to run tests before completing tasks
# Expected value: any string message
# TEST_EXECUTION_REMINDER_MESSAGE="You have made code changes but haven't run tests yet. Please run the test suite to verify your changes before completing this task."

# Health Check Settings
# Set to true to disable health checks globally (enabled by default for better reliability)
# DISABLE_HEALTH_CHECKS=false 

# Activity Tracking Settings
# Enable real-time connection activity tracking (RX/TX counters per session)
# Disabled by default for performance - enable for debugging/monitoring
# ENABLE_ACTIVITY_TRACKING=false

# Anthropic API Keys for Round-Robin Configuration
# WARNING: Replace these placeholder values with your actual API keys
ANTHROPIC_API_KEY_1=your_first_anthropic_api_key_here
ANTHROPIC_API_KEY_2=your_second_anthropic_api_key_here
# Provide single key instead:
# WARNING: Replace with your actual API key
# ANTHROPIC_API_KEY=your_single_anthropic_key

# Nvidia NIM / hosted integrator (OpenAI-compatible backend)
# NVIDIA_API_KEY=your_nvidia_api_key_here

# runinfra.ai (OpenAI-compatible backend)
# RUNINFRA_API_KEY=your_runinfra_api_key_here
