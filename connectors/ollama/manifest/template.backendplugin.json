{
  "schema": "aiproxer.backendplugin.manifest/v1",
  "plugin_id": "com.aiproxer.backend.ollama",
  "version": "0.1.0",
  "build_id": "REPLACE_BUILD_ID",
  "executable": "bin/aip-backend-ollama",
  "sha256": "REPLACE_SHA256",
  "protocol_major": 1,
  "protocol_min_minor": 0,
  "protocol_max_minor": 0,
  "platforms": [
    {"os": "windows", "arch": "amd64"},
    {"os": "windows", "arch": "arm64"},
    {"os": "linux", "arch": "amd64"},
    {"os": "linux", "arch": "arm64"}
  ],
  "exports": [
    {
      "kind": "ollama",
      "credential_mode": "none",
      "access_scope": "local_only",
      "process_sharing": "per_instance",
      "execution_class": "inference"
    },
    {
      "kind": "ollama-cloud",
      "credential_mode": "static",
      "access_scope": "any",
      "process_sharing": "per_instance",
      "execution_class": "inference",
      "credential_contract": {
        "version": 2,
        "class": "api_key",
        "source": "host_env",
        "env_root": "OLLAMA_CLOUD_API_KEY",
        "slot": "api_key",
        "selection": "quota_pre_output",
        "quota_domain": "ollama-cloud"
      }
    }
  ]
}
