{
  "schema": "aiproxer.backendplugin.manifest/v1",
  "plugin_id": "com.aiproxer.backend.claudeagentacp",
  "version": "0.1.0",
  "build_id": "REPLACE_BUILD_ID",
  "executable": "bin/aip-backend-claudeagentacp",
  "sha256": "REPLACE_SHA256",
  "protocol_major": 1,
  "protocol_min_minor": 0,
  "protocol_max_minor": 11,
  "platforms": [{"os": "linux", "arch": "amd64"}],
  "exports": [
    {
      "kind": "claudeagentacp",
      "experimental": true,
      "credential_mode": "static",
      "access_scope": "local_only",
      "process_sharing": "per_instance",
      "execution_class": "agent_runtime",
      "credential_contract": {
        "version": 2,
        "class": "static_nonrotatable",
        "source": "host_env",
        "env_root": "CLAUDE_CODE_OAUTH_TOKEN",
        "slot": "api_token",
        "selection": "session_admission",
        "quota_domain": "claude-agent"
      }
    }
  ]
}
