{
  "schema": "aiproxer.backendplugin.manifest/v1",
  "plugin_id": "com.aiproxer.backend.vertex",
  "version": "0.1.0",
  "build_id": "REPLACE_BUILD_ID",
  "executable": "bin/aip-backend-vertex",
  "sha256": "REPLACE_SHA256",
  "protocol_major": 1,
  "protocol_min_minor": 0,
  "protocol_max_minor": 0,
  "platforms": [
    {"os": "windows", "arch": "amd64"},
    {"os": "windows", "arch": "arm64"},
    {"os": "linux", "arch": "amd64"},
    {"os": "linux", "arch": "arm64"}
  ],
  "exports": [
    {
      "kind": "vertex",
      "credential_mode": "static",
      "access_scope": "any",
      "process_sharing": "per_instance",
      "execution_class": "inference",
      "credential_contract": {
        "version": 2,
        "class": "static_nonrotatable",
        "source": "host_env",
        "env_root": "VERTEX_API_KEY",
        "slot": "api_key",
        "selection": "no_rotation",
        "quota_domain": "vertex-ai"
      }
    }
  ]
}
