# Native fuzz corpora must use LF-only line endings (Go rejects CRLF in corpus files).
testdata/**/fuzz/** text eol=lf

# Keep root ignore file LF-only so `git diff --check` stays clean on Windows checkouts.
/.gitignore text eol=lf
/.github/workflows/*.yml text eol=lf
docs/dogfood-local.md whitespace=cr-at-eol

# JSON fixtures and spec metadata intentionally retain CRLF on Windows.
*.json whitespace=cr-at-eol

# Generated feature plane storage — keep LF on Windows so -check byte-compare passes.
/pkg/aipsdk/feature/plane_generated.go text eol=lf

# AIProxer Enterprise tree: closed source, never part of the open-source export.
/enterprise export-ignore
/enterprise/** export-ignore
.github/dependabot.yml export-ignore

