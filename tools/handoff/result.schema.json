{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "role", "task", "status", "source", "behavioral", "commands", "findings"],
  "properties": {
    "version": {"const": 1},
    "role": {"enum": ["implementer", "reviewer"]},
    "task": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY_FOR_REVIEW", "BLOCKED", "NEEDS_CONTEXT", "APPROVED", "REJECTED"]},
    "behavioral": {"type": "boolean"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "fingerprint"],
      "properties": {
        "head": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "argv", "exit_code", "evidence"],
        "properties": {
          "purpose": {"enum": ["red", "verification", "baseline"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "evidence": {"type": "string", "minLength": 1},
          "command_record": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "detail"],
        "properties": {
          "severity": {"enum": ["Critical", "Important", "Suggestion", "FYI"]},
          "file": {"type": "string"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocker": {"type": "string"},
    "remediation": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "implementer"}}},
      "then": {"properties": {"status": {"enum": ["READY_FOR_REVIEW", "BLOCKED", "NEEDS_CONTEXT"]}}},
      "else": {"properties": {"status": {"enum": ["APPROVED", "REJECTED"]}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["BLOCKED", "NEEDS_CONTEXT"]}}},
      "then": {"required": ["blocker"], "properties": {"blocker": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}},
      "then": {"required": ["remediation"], "properties": {"remediation": {"minLength": 1}, "findings": {"minItems": 1}}}
    }
  ],
  "$comment": "Run the Go validator too: it checks source freshness, evidence files, command results and contradictory findings; schema shape alone is not approval."
}
